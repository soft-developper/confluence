# Copy to .env for local development. Never commit .env.
# testnet | mainnet
CONFLUENCE_ENV=testnet
PORT=4000
# Comma separated bare origins allowed to call this API from a browser.
# mainnet accepts only public https origins.
CORS_ORIGINS=http://localhost:3000
# Turso database for THIS environment (from the Turso dashboard)
TURSO_DATABASE_URL=libsql://confluence-testnet-<your-org>.turso.io
TURSO_AUTH_TOKEN=
# Proxy hops to trust for client IPs: 0 locally, 3 on Render (verified in Stage 0f)
TRUST_PROXY_HOPS=0
# Max requests per second from this API to Circle's CCTP API (max 15; Circle's limit is 35)
CIRCLE_MAX_RPS=10
# Stage 4 tracker (checks unfinished transfers while the API is awake)
TRACKER_ENABLED=true
TRACKER_INTERVAL_MS=60000
# Circle API key for THIS environment (testnet and mainnet keys differ)
CIRCLE_API_KEY=
