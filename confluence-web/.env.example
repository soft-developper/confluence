# Copy to .env.local for local development. Never commit it.
# Only browser-safe values belong here: everything NEXT_PUBLIC_* is visible to users.
# testnet | mainnet (must match the API's CONFLUENCE_ENV)
NEXT_PUBLIC_CONFLUENCE_ENV=testnet
# Bare origin of confluence-api, no trailing slash
NEXT_PUBLIC_API_URL=http://localhost:4000
# Reown (WalletConnect) project ID from dashboard.reown.com. Optional locally:
# without it the WalletConnect option is hidden. Public by design (browser-visible).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
